# Telegram
# Buat bot di @BotFather lalu salin token ke sini
BOT_TOKEN=replace_with_botfather_token
# Numeric Telegram user ID pemilik bot (cek di @userinfobot / @getinfo_bot)
ALLOWED_USER_ID=123456789

# OpenAI-compatible AI router
ROUTER_API_KEY=replace_with_router_api_key
ROUTER_BASE_URL=http://localhost:20128/v1
ROUTER_MODEL=PersonalAssistant

# Market data (opsional, untuk /saham, /ekonomi, dan analisa market)
ALPHA_VANTAGE_KEY=replace_with_alpha_vantage_key
FMP_API_KEY=replace_with_fmp_api_key

# Web search (opsional, untuk /cari dan auto-search)
TAVILY_API_KEY=replace_with_tavily_api_key
SERPAPI_KEY=replace_with_serpapi_key
NEWSAPI_KEY=replace_with_newsapi_key

# Informasi & riset tambahan (opsional — tool AI: read_url, crypto, kurs, cuaca, gempa, libur, Bank Dunia)
# Jina Reader: tanpa key tetap jalan (20 req/menit); key gratis = 500 req/menit + 10M token — https://jina.ai/reader
JINA_API_KEY=replace_with_jina_api_key
# CoinGecko Demo (harga crypto IDR/USD) — https://www.coingecko.com/en/developers/dashboard
COINGECKO_API_KEY=replace_with_coingecko_demo_key
# ExchangeRate-API (kurs 160+ mata uang; fallback otomatis Frankfurter tanpa key) — https://app.exchangerate-api.com
EXCHANGERATE_API_KEY=replace_with_exchangerate_api_key
# Tanpa API key: BMKG (gempa), Tanggal Merah upset.dev (libur ID), Open-Meteo (cuaca), Frankfurter (kurs fallback), World Bank Data360 (makro)

# MoneyTracker Google Sheets (opsional, untuk /keuangan, /pengeluaran, /catat)
# Syarat setup:
# 1. Siapkan Google Sheets berisi tab: Dashboard, Income, Usage, Expenses, Database
# 2. Buka Ekstensi -> Apps Script, tempel kode dari apps-script/MoneyTracker.gs
# 3. Isi Script Property SHEET_API_SECRET di Setelan Project Apps Script (harus sama dengan di bawah)
# 4. Deploy -> Deployment baru -> Aplikasi web (Jalankan sebagai: Saya, Akses: Siapa saja)
# 5. Salin URL /exec hasil deploy ke SHEET_WEBHOOK_URL di bawah
SHEET_WEBHOOK_URL=https://script.google.com/macros/s/replace_with_deployment_id/exec
SHEET_API_SECRET=replace_with_shared_secret

# Database retention (opsional, hari)
CONVERSATION_RETENTION_DAYS=90

# Health check server (opsional)
PORT=3000

# Workspace & Knowledge Base (opsional — jika sudah diset di OS/User Environment Variables tidak wajib ditulis di .env.local)
# TRELLO_API_KEY=replace_with_trello_api_key
# TRELLO_API_TOKEN=replace_with_trello_api_token
# NOTION_API_KEY=replace_with_notion_integration_token
# SUPERHUMAN_API_TOKEN=replace_with_superhuman_docs_token
# KB_DIR=C:/path/to/your/obsidian-vault
